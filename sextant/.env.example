# ───────────────────────── Sextant configuration ─────────────────────────
# Copy to .env and fill in. Never commit .env. Run `python -m sextant.doctor`
# afterwards: it makes one real call to each service and tells you what works.

# ── Required ─────────────────────────────────────────────────────────────
# From @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID (ask @userinfobot). Comma-separate several.
# Anyone not listed here is refused.
ALLOWED_USER_IDS=

# ── AI providers (at least one; tried in this order, falling back on failure) ──
AI_PROVIDER_ORDER=gemini,groq,openrouter,custom,ollama

# Google Gemini: text AND image understanding. Free key, no card:
# https://aistudio.google.com/apikey
# Model names and free quotas change often. If the doctor reports "HTTP 404",
# open AI Studio, pick a current Flash-Lite model and paste its ID here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq: fast free text fallback. https://console.groq.com/keys
# Leave GROQ_VISION_MODEL empty unless you have confirmed a vision model on your tier.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=

# OpenRouter free models. https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_VISION_MODEL=

# Local models through Ollama (free, needs your own hardware), e.g. http://localhost:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=

# Any other OpenAI-compatible endpoint (Cloudflare Workers AI, Mistral, a paid key, ...)
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
CUSTOM_AI_VISION_MODEL=

# OCR-only fallback for images when no vision model is available (reads text, cannot
# interpret charts or scenes). Free key: https://ocr.space/ocrapi
OCR_SPACE_API_KEY=

# Safety ceilings (per provider, enforced locally whatever the provider allows)
AI_DAILY_REQUEST_LIMIT=400
AI_MIN_INTERVAL_SECONDS=4.5
AI_MAX_RETRIES=3

# ── Web search (tried in order; DuckDuckGo needs no key but is best-effort) ──
SEARCH_PROVIDER_ORDER=brave,tavily,searxng,duckduckgo
# Tavily: https://app.tavily.com  (free monthly credits, no card at time of writing)
TAVILY_API_KEY=
# Brave: https://api-dashboard.search.brave.com  (monthly credit; card required)
BRAVE_API_KEY=
# Your own SearXNG instance with JSON output enabled, e.g. http://localhost:8888
SEARXNG_URL=
SEARCH_CACHE_HOURS=24
RESPECT_ROBOTS_TXT=true

# ── Research behaviour ───────────────────────────────────────────────────
# quick | standard | deep  (also available per request: /quick, /search, /deep)
RESEARCH_DEPTH=standard
MAX_RESEARCH_PER_HOUR=6
# Seconds a new task waits so you can attach images or extra context. 0 = start at once.
ATTACH_WINDOW_SECONDS=8
MAX_REPORT_CHARS=16000
MAX_IMAGE_MB=10
MAX_IMAGES_PER_TASK=6

# ── Optional daily research ──────────────────────────────────────────────
# Runs only if this is true AND you set an objective with /schedule in Telegram.
SCHEDULER_ENABLED=false
DEFAULT_TIMEZONE=Africa/Lagos

# ── Storage and logging ──────────────────────────────────────────────────
DATA_DIR=data
LOG_LEVEL=INFO
