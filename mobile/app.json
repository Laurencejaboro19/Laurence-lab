{
  "expo": {
    "name": "Laurence Lab",
    "slug": "laurence-lab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "laurencelab",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#120F0B",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#120F0B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.laurencelab.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Laurence Lab uses your location to confirm your delivery zone and fee.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.laurencelab.app",
      "adaptiveIcon": {
        "backgroundColor": "#120F0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      ["expo-location", { "locationWhenInUsePermission": "Laurence Lab uses your location to confirm your delivery zone and fee." }],
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#120F0B" }]
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "apiBaseUrl": "https://laurence-lab-bot.vercel.app",
      "eas": { "projectId": "" }
    }
  }
}
