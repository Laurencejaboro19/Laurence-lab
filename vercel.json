{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm ci --ignore-scripts --include=dev",
  "framework": null,
  "regions": ["lhr1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/jobs/daily",
      "schedule": "0 3 * * *"
    }
  ],
  "outputDirectory": "public"
}
