# Laurence Lab Bot — environment variables
#
# Copy to .env for local development:  cp .env.example .env
# NEVER commit .env. Every value here is a placeholder; real values live only in
# your local .env or in the host's secret store. Separate keys per environment.
#
# Which connection string does what (see README "Database connections"):
#   DATABASE_URL          runtime app traffic — may be the Supabase *transaction* pooler
#   DATABASE_URL_DIRECT   job queue, scheduler locks, migrations — MUST be a direct or
#                         *session*-mode connection (advisory locks + LISTEN/NOTIFY need it)
#   DATABASE_URL_TEST     local Postgres used by integration tests (optional; tests skip without it)

NODE_ENV=development
LOG_LEVEL=info
APP_TIMEZONE=Africa/Lagos
PORT=3000

# --- Database (Supabase Postgres in staging/production, plain Postgres locally) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME  (passwords deliberately left out of this file)
DATABASE_URL=postgres://app_runtime@localhost:5432/laurence_lab
DATABASE_URL_DIRECT=postgres://app_runtime@localhost:5432/laurence_lab
DATABASE_URL_MIGRATE=postgres://app_migrate@localhost:5432/laurence_lab
DATABASE_URL_TEST=postgres://app_migrate@localhost:5432/laurence_lab_test          # integration tests (migrate role)
DATABASE_URL_TEST_RUNTIME=postgres://app_runtime@localhost:5432/laurence_lab_test  # integration tests (runtime role)

# --- Internal API ---
# Random 32+ byte secret used to sign internal API tokens for chat adapters and the admin bot.
INTERNAL_API_SECRET=replace-with-openssl-rand-hex-32

# --- Telegram (test bots in development/staging; separate production bots) ---
TELEGRAM_CUSTOMER_BOT_TOKEN=
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32
TELEGRAM_MODE=polling            # polling (local) | webhook (production)
PUBLIC_BASE_URL=http://localhost:3000

# --- Paystack (TEST keys only in development; live keys are set by the owner in production) ---
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_BASE_URL=https://api.paystack.co   # local dev: http://127.0.0.1:4010 with `npm run mock:paystack`
# Local mock only: where the mock posts signed webhooks (your server)
MOCK_PAYSTACK_WEBHOOK_URL=http://127.0.0.1:3000/webhooks/paystack
MOCK_PAYSTACK_PORT=4010

# --- Delivery provider ---
DELIVERY_PROVIDER=manual         # manual | kwik | mock
KWIK_API_KEY=
KWIK_BASE_URL=

# --- Maps / geocoding ---
GEOCODER_PROVIDER=none           # none | google | nominatim
GOOGLE_MAPS_API_KEY=

# --- AI (optional, off by default; owner supplies the key) ---
AI_ENABLED=false
AI_PROVIDER=anthropic            # anthropic | openai | none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- WhatsApp Cloud API (phase 9) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- Monitoring ---
SENTRY_DSN=
