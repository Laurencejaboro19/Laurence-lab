# ---- Required ----
# Get this from @BotFather on Telegram (/newbot)
BOT_TOKEN=123456789:ABCDEF-your-bot-token

# Telegram user IDs (comma separated) that receive new orders / support messages
# and can run admin commands. Find yours by sending /myid to the bot.
ADMIN_CHAT_IDS=
# …or simply list staff Telegram @usernames; they become admins the first time they message the bot
ADMIN_USERNAMES=

# ---- Optional ----
DB_PATH=laurence_lab.db
CURRENCY_SYMBOL=₦

# Bank transfer details shown to customers who pick "Bank Transfer"
BANK_NAME=Laurence Lab Bank
BANK_ACCOUNT_NAME=Laurence Lab Kitchen
BANK_ACCOUNT_NUMBER=0123456789

# Paystack (https://dashboard.paystack.com/#/settings/developer) – enables "Pay online" button
PAYSTACK_SECRET_KEY=

# Telegram native payments – provider token from @BotFather (/mybots -> Payments)
TELEGRAM_PROVIDER_TOKEN=

# Webhook mode (leave empty to use long polling, which works anywhere)
WEBHOOK_URL=
PORT=8080
